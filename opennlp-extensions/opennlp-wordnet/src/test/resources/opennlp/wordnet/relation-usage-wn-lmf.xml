<LexicalResource>
  <Lexicon id="relations" label="Relation usage fixture" language="en" version="1">
    <LexicalEntry id="purchase-entry-v">
      <Lemma writtenForm="purchase" partOfSpeech="v"/>
      <Sense id="purchase-sense-v" synset="purchase-v"/>
    </LexicalEntry>
    <LexicalEntry id="buyer-entry-n">
      <Lemma writtenForm="buyer" partOfSpeech="n"/>
      <Sense id="buyer-sense-n" synset="buyer-n"/>
    </LexicalEntry>
    <LexicalEntry id="card-entry-n">
      <Lemma writtenForm="payment card" partOfSpeech="n"/>
      <Sense id="card-sense-n" synset="card-n"/>
    </LexicalEntry>
    <Synset id="purchase-v" partOfSpeech="v" members="purchase-sense-v">
      <Definition>obtain something by paying for it</Definition>
      <SynsetRelation relType="involved_agent" target="buyer-n"/>
      <SynsetRelation relType="involved_instrument" target="card-n"/>
    </Synset>
    <Synset id="buyer-n" partOfSpeech="n" members="buyer-sense-n">
      <Definition>a person who buys something</Definition>
    </Synset>
    <Synset id="card-n" partOfSpeech="n" members="card-sense-n">
      <Definition>a card used to make a payment</Definition>
    </Synset>
  </Lexicon>
</LexicalResource>
