<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.apache.opennlp</groupId>
    <artifactId>opennlp</artifactId>
    <version>3.0.0-OPENNLP-1833-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>opennlp-native-tests</artifactId>
  <packaging>jar</packaging>
  <name>Apache OpenNLP :: Native Image Tests</name>
  <description>
    Smoke test for GraalVM native images: a small application that loads models from files and runs
    sentence detection, tokenization, POS tagging and name finding. The image is built and run with the
    "native" profile, which needs a GraalVM JDK 25 or later with native-image; without the profile only
    the classes are compiled.
  </description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
    <!-- Directory holding the models the smoke test loads, see NativeSmoke for the file names. -->
    <opennlp.native.models>${user.home}/.opennlp</opennlp.native.models>
    <opennlp.native.image>opennlp-native-smoke</opennlp.native.image>
    <native.maven.plugin>1.1.13</native.maven.plugin>
    <exec.maven.plugin>3.6.4</exec.maven.plugin>
  </properties>

  <dependencies>
    <!-- Internal dependencies -->
    <dependency>
      <groupId>org.apache.opennlp</groupId>
      <artifactId>opennlp-runtime</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.opennlp</groupId>
      <artifactId>opennlp-ml-maxent</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.opennlp</groupId>
      <artifactId>opennlp-ml-perceptron</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.opennlp</groupId>
      <artifactId>opennlp-ml-bayes</artifactId>
    </dependency>

    <!-- External dependencies -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-javadoc-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-source-plugin</artifactId>
        <configuration>
          <skipSource>true</skipSource>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <version>${native.maven.plugin}</version>
            <executions>
              <execution>
                <id>build-native-smoke</id>
                <goals>
                  <goal>compile-no-fork</goal>
                </goals>
                <phase>package</phase>
              </execution>
            </executions>
            <configuration>
              <imageName>${opennlp.native.image}</imageName>
              <mainClass>opennlp.tools.nativeimage.NativeSmoke</mainClass>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>${exec.maven.plugin}</version>
            <executions>
              <execution>
                <id>run-native-smoke</id>
                <goals>
                  <goal>exec</goal>
                </goals>
                <phase>verify</phase>
                <configuration>
                  <executable>${project.build.directory}/${opennlp.native.image}</executable>
                  <arguments>
                    <argument>${opennlp.native.models}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
