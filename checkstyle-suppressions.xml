<!--
  Exceptions to the two regex checks in checkstyle.xml (ids NoRegexImport and NoRegexStringCall).
  Production code is regex-free by policy; a class is listed here only when regular expressions
  are its documented contract. Tests may use regular expressions freely.
-->
<suppressions>

  <!-- Tests may compare a scan against the pattern it replaced. -->
  <suppress id="NoRegexImport" files="[\\/]src[\\/]test[\\/]"/>
  <suppress id="NoRegexStringCall" files="[\\/]src[\\/]test[\\/]"/>

  <!-- The class is a regex step: the user supplies the patterns. -->
  <suppress id="NoRegexImport" files="[\\/]namefind[\\/]RegexNameFinder(Factory)?\.java"/>

  <!-- Head rules are regex strings defined by the AnCora treebank specification. -->
  <suppress id="NoRegexImport" files="[\\/]parser[\\/]lang[\\/]es[\\/]AncoraSpanishHeadRules\.java"/>

  <!-- Penn Treebank constituent markup grammar. -->
  <suppress id="NoRegexImport" files="[\\/]parser[\\/]Parse\.java"/>

  <!-- Name sample markup grammar. -->
  <suppress id="NoRegexImport" files="[\\/]namefind[\\/]NameSample\.java"/>

  <!-- The URL heuristic is an alternation of schemes, an email shape, and a TLD list. -->
  <suppress id="NoRegexImport"
            files="[\\/]spellcheck[\\/]normalizer[\\/]SpellCheckingCharSequenceNormalizer\.java"/>

  <!--
    The alphanumeric pattern is a tokenizer model parameter stored in the manifest as a regex,
    so the Pattern type is part of the model contract. Matching runs through AlphaNumericCheck,
    which evaluates the built-in defaults as a character set lookup.
  -->
  <suppress id="NoRegexImport"
            files="[\\/]tokenize[\\/](TokenizerFactory|TokenizerME|TokSpanEventStream|AlphaNumericCheck|lang[\\/]Factory)\.java"/>

</suppressions>
